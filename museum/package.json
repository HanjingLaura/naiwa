    "test": "vitest run",
    "assets": "python3 scripts/prepare-assets.py"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
